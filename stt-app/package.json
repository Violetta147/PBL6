{
  "name": "pbl6-stt",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3100",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100",
    "desktop:dev": "node scripts/desktop.mjs --dev",
    "desktop": "node scripts/desktop.mjs",
    "desktop:kiosk": "node scripts/desktop.mjs --kiosk",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:ui": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.65.0",
    "electron": "45.2.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
