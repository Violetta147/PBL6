{
  "preprocessing_version": "1.1.0",
  "mediapipe": {
    "pose": {"model_complexity": 1, "min_detection_confidence": 0.5, "min_tracking_confidence": 0.5},
    "hands": {"max_num_hands": 2, "min_detection_confidence": 0.5, "min_tracking_confidence": 0.5},
    "face_mesh": {"max_num_faces": 1, "min_detection_confidence": 0.5, "min_tracking_confidence": 0.5}
  },
  "hand_normalization": {"anchor": "wrist", "scale": "wrist_to_middle_mcp", "wrist_index": 0, "middle_mcp_index": 9, "epsilon": 1e-8},
  "body_normalization": {"origin": "shoulder_midpoint", "scale": "shoulder_width", "epsilon": 1e-8},
  "handedness": {"strategy": "pose_wrist_proximity", "proximity_threshold": 0.15, "use_tracking_fallback": true, "use_mediapipe_label_fallback": true, "flag_uncertain_assignments": true},
  "palm_indices": [0, 5, 9, 13, 17],
  "face": {"enabled": false},
  "relations": {"include_face": false},
  "feature_groups": {"raw_coordinates": false}
}
